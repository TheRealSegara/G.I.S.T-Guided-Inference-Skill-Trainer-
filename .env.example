# Copy this file to .env.local for local development (npm run dev via `vercel dev`),
# or set these as Environment Variables in the Vercel project settings for deployment.

# Your Groq API key from console.groq.com/keys. Free tier, no credit
# card required. Never commit this. Used only by api/claude.js
# (server-side), never sent to the browser.
# Rotate it (delete the old key, generate a new one, update this value)
# immediately if it's ever pasted into chat, a screenshot, a public repo,
# or anywhere else outside Vercel's Environment Variables UI, and
# periodically as routine hygiene even if nothing seems wrong.
GROQ_API_KEY=

# Optional: override the Groq model used. Defaults to
# "llama-3.1-8b-instant" if unset. Check console.groq.com/docs/models
# for the current list of available free-tier models if the default
# ever stops working.
GROQ_MODEL=

# Comma-separated list of origins allowed to call /api/claude and
# /api/auth, e.g. https://your-app.vercel.app,http://localhost:5173
# Leave empty during initial setup to allow all origins; set this before
# sharing the deployed link publicly.
ALLOWED_ORIGINS=

# Comma-separated list of access codes teachers/schools enter to unlock
# the app, e.g. apple123:SMK Jaya,banana456:SMK Bukit. The part after
# ":" is an optional label used only for per-code quota tracking; if
# omitted, the code itself is used as the label. Required.
ACCESS_CODES=

# Long random secret used to sign the short-lived session tokens issued
# after a correct access code (e.g. `openssl rand -hex 32`). Must be
# different from GROQ_API_KEY, never commit it, never expose it to the
# browser. Required. Rotating this value (generate a new random string,
# update it here) instantly invalidates every currently-issued token,
# forcing everyone to re-enter their access code, harmless since no
# session data is lost by design, useful if this value is ever exposed.
AUTH_SECRET=

# Optional: how long an access-code session stays valid, in minutes.
# Defaults to 720 (12 hours, a school day plus margin).
TOKEN_TTL_MINUTES=

# Optional: max /api/claude requests per access code per day. Defaults
# to 200, deliberately conservative against llama-3.1-8b-instant's
# free-tier ceiling (500,000 tokens/day, no billing account linked —
# check your own live numbers at console.groq.com/docs/rate-limits, they
# can differ by account and model). Raising this past Groq's own ceiling
# doesn't unlock more real usage, Groq's limit is hit first either way;
# only raise it if you've moved to a paid Groq tier with a higher
# ceiling. Tracked in-memory per server instance (best-effort, see
# README), not a hard global cap.
DAILY_QUOTA_PER_CODE=

# Optional: max /api/claude requests per minute per IP. Defaults to 10.
# A strict division of Groq's 6,000-tokens/minute free-tier ceiling by
# this app's ~1,800-1,900-token coach calls suggests ~3/minute, but that
# was confirmed too tight live: normal single-student play (a hint, an
# occasional retry, the transfer test firing right after resolution) can
# stack more than 3 real calls in a minute without anything being wrong.
# This is a cheap first layer against obvious abuse, not a precise model
# of Groq's token budget; Groq's own real error and the Vercel Firewall
# rule are the actual backstops.
RATE_LIMIT_MAX_REQUESTS=

# Only relevant when running server.js (Cloud Run / generic Node
# hosting, not Vercel). Leave unset unless this process sits behind a
# real reverse proxy/load balancer that sets X-Forwarded-For itself
# (e.g. Cloud Run's own routing layer) — if so, set it to the exact
# number of trusted hops in front of it (usually 1). Left unset by
# default so a client can't just send their own X-Forwarded-For header
# to fake their IP and bypass the rate limiter and /api/auth's
# brute-force guard, confirmed possible when this trusted a hop that
# wasn't actually there.
TRUST_PROXY_HOPS=
