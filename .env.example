# Copy this file to .env.local for local development (npm run dev via `vercel dev`),
# or set these as Environment Variables in the Vercel project settings for deployment.

# Your Gemini API key from Google AI Studio (aistudio.google.com/apikey).
# Free tier, no credit card required. Never commit this. Used only by
# api/claude.js (server-side), never sent to the browser.
GEMINI_API_KEY=

# Optional: override the Gemini model used. Defaults to "gemini-2.5-flash"
# if unset. Check aistudio.google.com for the current list of available
# free-tier models if the default ever stops working.
GEMINI_MODEL=

# Comma-separated list of origins allowed to call /api/claude, e.g.
# https://your-app.vercel.app,http://localhost:5173
# Leave empty during initial setup to allow all origins; set this before
# sharing the deployed link publicly.
ALLOWED_ORIGINS=
